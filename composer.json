{
    "name": "pieceofcake2/vite",
    "description": "Vite integration for CakePHP 2",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "vite"],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "composer/installers": \"^1.0 || ^2.0\",
        "pieceofcake2/cakephp": "^2.12"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2"
    },
    "autoload": {
        "classmap": ["View/"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "Vite"
    }
}
